# Copy this file to .env and fill in real values. Never commit the real .env — it's already
# listed in .gitignore. These are read directly from the shell environment (via process.env),
# not loaded automatically — see README.md "Setting your environment variables".

# Required to publish anything (--publish on the CLI, or the seed/sample scripts).
# A 0x-prefixed private key for a Tiramisu testnet wallet. Fund it first — see README.md
# "Getting a funded wallet". NEVER use a key that holds real funds on any network.
USALAMA_PRIVATE_KEY=

# Optional. Override the default public Tiramisu RPC endpoint.
# ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network

# Optional. An Arkiv Hub API key, if you have one and are past the unauthenticated query budget.
# See arkiv/friction.md entry 3 — we could not confirm the exact header hub.arkiv.network expects,
# so the header name itself is also configurable below.
# ARKIV_API_KEY=
# ARKIV_API_KEY_HEADER=x-api-key
